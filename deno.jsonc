{
    "unstable": [
        "kv"
    ],
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "lib": [
            "esnext",
            "dom.iterable",
            "dom.asynciterable",
            "deno.window",
            "deno.unstable",
            "dom",
        ]
    },
    "tasks": {
        "cdn": "cd asset-pipeline && deno run --watch -A mod.ts",
        "dev": "deno run -A vite",
        "build": "deno run -A vite build",
        "test": "deno test merge-game/",
        "lint": "deno lint && deno check merge-game/ block-game/"
    },
    "imports": {
        "@babylonjs/core": "npm:@babylonjs/core@^9.0.0",
        "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
        "@gfx/canvas-wasm": "jsr:@gfx/canvas-wasm@^0.4.2",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/cache": "jsr:@std/cache@^0.2.2",
        "@std/cbor": "jsr:@std/cbor@^0.1.9",
        "@std/collections": "jsr:@std/collections@^1.1.6",
        "@std/fs": "jsr:@std/fs@^1.0.23",
        "@std/http": "jsr:@std/http@^1.0.25",
        "@std/path": "jsr:@std/path@^1.1.4",
        "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.24",
        "maxrects-packer": "npm:maxrects-packer@^2.7.3",
        "vite": "npm:vite@^7.3.1"
    }
}